---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { SITE } from "../consts";
import { HOME_LEDE } from "../utils/page-meta";
import { getPublishedPosts } from "../utils/posts";

const posts = await getPublishedPosts();
const [featured, ...rest] = posts;
---

<BaseLayout ogRoute="home">
  <section class="container intro">
    <p class="eyebrow rise" style="--d:0s">Writing</p>
    <h1 class="intro-title rise" style="--d:0.06s">{SITE.tagline}</h1>
    <p class="intro-lede rise" style="--d:0.12s">{HOME_LEDE}</p>
  </section>

  {
    featured && (
      <section class="container featured-wrap" aria-label="Featured">
        <p class="eyebrow featured-label">Featured</p>
        <PostCard post={featured} featured index={0} />
      </section>
    )
  }

  {
    rest.length > 0 && (
      <section class="container">
        <div class="section-head">
          <h2 class="section-title">Recent writing</h2>
          <span class="rule" aria-hidden="true" />
        </div>
        <div class="grid">
          {rest.map((post, i) => (
            <PostCard post={post} index={i + 1} />
          ))}
        </div>
      </section>
    )
  }

  {
    posts.length === 0 && (
      <section class="container empty">
        <p>No posts yet. The first one is on its way.</p>
      </section>
    )
  }
</BaseLayout>

<style>
  .intro {
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
    max-width: 56rem;
  }
  .intro-title {
    font-size: var(--step-4);
    letter-spacing: -0.03em;
    margin-top: 0.5rem;
    max-width: 18ch;
  }
  .intro-lede {
    margin-top: 1.4rem;
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--muted);
    max-width: 54ch;
  }

  .featured-wrap {
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
  }
  .featured-label {
    margin-bottom: 1.4rem;
  }

  .section-head {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 3.5rem;
    margin-bottom: 2rem;
  }
  .section-title {
    font-size: var(--step-2);
    letter-spacing: -0.025em;
    white-space: nowrap;
  }
  .rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(
      to right,
      var(--accent-ink),
      var(--border-strong) 18%,
      transparent
    );
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    gap: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .empty {
    padding-block: 5rem;
    color: var(--muted);
    font-style: italic;
  }
</style>
