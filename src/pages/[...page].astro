---
import type { GetStaticPaths, Page } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import Pagination from "../components/Pagination.astro";
import { SITE } from "../consts";
import { HOME_LEDE } from "../utils/page-meta";
import { getPublishedPosts, PAGE_SIZE } from "../utils/posts";
import { homeJsonLd } from "../utils/jsonld";
import type { Post } from "../utils/posts";

// The home list, paginated: / then /2, /3, ... The newest post is pulled out
// as the featured card, shown on page 1 only; pagination applies to the rest,
// so page 1 holds 1 + PAGE_SIZE posts and the other pages exactly PAGE_SIZE.
export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts();
  const [featured, ...rest] = posts;
  return paginate(rest, { pageSize: PAGE_SIZE, props: { featured } });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
  featured?: Post;
}

const { page, featured } = Astro.props;
const isFirstPage = page.currentPage === 1;
const jsonLd = isFirstPage
  ? homeJsonLd(new URL("/", Astro.site ?? Astro.url))
  : undefined;
---

<BaseLayout
  title={isFirstPage ? undefined : `Writing, page ${page.currentPage}`}
  ogRoute="home"
  jsonLd={jsonLd}
  prev={page.url.prev}
  next={page.url.next}
>
  <section class="container intro">
    <p class="eyebrow rise" style="--d:0s">Writing</p>
    <h1 class="intro-title rise" style="--d:0.06s">{SITE.tagline}</h1>
    <p class="intro-lede rise" style="--d:0.12s">{HOME_LEDE}</p>
  </section>

  {
    isFirstPage && featured && (
      <section class="container featured-wrap" aria-label="Featured">
        <p class="eyebrow featured-label">Featured</p>
        <PostCard post={featured} featured index={0} />
      </section>
    )
  }

  {
    page.data.length > 0 && (
      <section class="container">
        <div class="section-head">
          <h2 class="section-title">
            {isFirstPage ? "Recent writing" : "Older writing"}
          </h2>
          <span class="rule" aria-hidden="true" />
        </div>
        <div class="grid">
          {page.data.map((post, i) => (
            <PostCard post={post} index={i + 1} />
          ))}
        </div>
      </section>
    )
  }

  {
    !featured && page.data.length === 0 && (
      <section class="container empty">
        <p>No posts yet. The first one is on its way.</p>
      </section>
    )
  }

  <div class="container">
    <Pagination page={page} />
  </div>
</BaseLayout>

<style>
  .intro {
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
    max-width: 56rem;
  }
  .intro-title {
    font-size: var(--step-4);
    letter-spacing: -0.03em;
    margin-top: 0.5rem;
    max-width: 18ch;
  }
  .intro-lede {
    margin-top: 1.4rem;
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--muted);
    max-width: 54ch;
  }

  .featured-wrap {
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
  }
  .featured-label {
    margin-bottom: 1.4rem;
  }

  .section-head {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 3.5rem;
    margin-bottom: 2rem;
  }
  .section-title {
    font-size: var(--step-2);
    letter-spacing: -0.025em;
    white-space: nowrap;
  }
  .rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(
      to right,
      var(--accent-ink),
      var(--border-strong) 18%,
      transparent
    );
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    gap: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .empty {
    padding-block: 5rem;
    color: var(--muted);
    font-style: italic;
  }
</style>
