---
import { render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Lightbox from "../../components/Lightbox.astro";
import { getPublishedPosts, formatDate, readingTime } from "../../utils/posts";
import type { Post } from "../../utils/posts";
import { resolveCover } from "../../utils/cover";
import { articleJsonLd } from "../../utils/jsonld";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  category,
  cover,
  coverAlt,
  coverCredit,
} = post.data;
const { Content } = await render(post);
const minutes = readingTime(post.body ?? "");
const resolvedCover = await resolveCover(cover);

const siteURL = Astro.site ?? Astro.url;
const canonical = new URL(`/blog/${post.id}/`, siteURL);
const jsonLd = articleJsonLd(siteURL, {
  title,
  description,
  url: canonical,
  image: new URL(`/og/blog/${post.id}.png`, siteURL),
  datePublished: pubDate.toISOString(),
  dateModified: updatedDate?.toISOString(),
  section: category,
});
---

<BaseLayout
  title={title}
  description={description}
  ogRoute={`blog/${post.id}`}
  article
  publishedTime={pubDate.toISOString()}
  modifiedTime={updatedDate?.toISOString()}
  jsonLd={jsonLd}
>
  <article class="post">
    <header class="container post-head prose-width">
      <a href="/" class="back">← All writing</a>
      <p class="pill">{category}</p>
      <h1 class="post-title">{title}</h1>
      <p class="post-desc">{description}</p>
      <p class="meta post-meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span class="meta-dot">{minutes} min read</span>
        {
          updatedDate && (
            <span class="meta-dot">updated {formatDate(updatedDate)}</span>
          )
        }
      </p>
    </header>

    <figure class="container cover">
      {
        "local" in resolvedCover ? (
          <Image
            src={resolvedCover.local}
            alt={coverAlt}
            format="avif"
            widths={[640, 1024, 1280, 1920]}
            sizes="(max-width: 70rem) 100vw, 70rem"
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <img
            src={resolvedCover.remote}
            alt={coverAlt}
            width="1280"
            height="720"
            fetchpriority="high"
          />
        )
      }
      {coverCredit && <figcaption>{coverCredit}</figcaption>}
    </figure>

    <div class="container">
      <div class="prose prose-width">
        <Content />
      </div>
    </div>

    <footer class="container post-foot prose-width">
      <a href="/" class="back">← Back to writing</a>
    </footer>
  </article>

  <Lightbox />
</BaseLayout>

<style>
  .post-head {
    padding-top: clamp(2rem, 5vw, 3.5rem);
    text-align: left;
  }
  .back {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 540;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 1.5rem;
    transition:
      color 0.2s var(--ease-out),
      transform 0.2s var(--ease-out);
  }
  .back:hover {
    color: var(--accent-ink);
    transform: translateX(-3px);
  }
  .post-title {
    font-size: var(--step-4);
    letter-spacing: -0.03em;
    margin-top: 0.9rem;
    line-height: 1.06;
  }
  .post-desc {
    margin-top: 1.1rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--muted);
    font-style: italic;
  }
  .post-meta {
    margin-top: 1.3rem;
    padding-bottom: 0.5rem;
  }

  .cover {
    margin-top: clamp(1.8rem, 4vw, 2.8rem);
    margin-bottom: clamp(2rem, 5vw, 3.2rem);
  }
  .cover img {
    width: 100%;
    max-height: 30rem;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
  }
  .cover figcaption {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--muted);
    text-align: center;
    margin-top: 0.7rem;
  }

  .post-foot {
    margin-top: 3.5rem;
    padding-top: 1.8rem;
    border-top: 1px solid var(--border);
  }
</style>
