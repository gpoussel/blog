---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Lightbox from "../components/Lightbox.astro";
import { SOCIALS } from "../consts";
import { ABOUT_TITLE, ABOUT_DESCRIPTION } from "../utils/page-meta";
import portrait from "../assets/photos/myself.jpg";
import aboutCerbere from "../assets/photos/about-cerbere.jpg";
import aboutFlower from "../assets/photos/about-flower.jpg";
import aboutStremy from "../assets/photos/about-stremy.jpg";

// A few photos from the road, shown as a justified strip lower on the page,
// kept apart from the portrait above. Aspect ratios drive the column widths
// (see .gallery-grid), so the row stays even-height without hardcoded numbers.
const gallery = [
  {
    src: aboutCerbere,
    alt: "The harbour at Cerbère, where the Pyrenees drop into the Mediterranean.",
  },
  {
    src: aboutFlower,
    alt: "A pink flower spike standing out against dense, sunlit greenery.",
  },
  {
    src: aboutStremy,
    alt: "A shaded courtyard terrace, cypress and olive around a still water channel.",
  },
];
---

<BaseLayout title={ABOUT_TITLE} description={ABOUT_DESCRIPTION} ogRoute="about">
  <section class="container about prose-width">
    <div class="intro">
      <figure class="portrait rise" style="--d:0s">
        <Image
          src={portrait}
          alt="Portrait of Guillaume"
          format="avif"
          widths={[80, 160, 240]}
          sizes="5rem"
          loading="eager"
        />
      </figure>
      <div class="intro-text">
        <p class="eyebrow rise" style="--d:0.06s">About</p>
        <h1 class="rise" style="--d:0.12s">Hi, I'm Guillaume.</h1>
      </div>
    </div>

    <div class="lede rise" style="--d:0.18s">
      <p>
        I'm a software architect and full-stack developer. For more than a
        decade I've designed systems for environments where a wrong decision is
        expensive to undo, which taught me to care less about the newest tool
        and more about the choices that still make sense a few years later.
      </p>
      <p>
        This blog is where I slow down. Between client work, side projects, and
        the open-source code I contribute to when I can, I wanted a place to
        think in full sentences instead of in pull-request comments, away from
        the noise of the feeds.
      </p>
      <p>
        I don't write to be right, but to understand. If something here
        resonates, or rubs you the wrong way, write to me: the conversation is
        usually worth more than the conclusion.
      </p>
    </div>

    <div class="topics rise" style="--d:0.24s">
      <h2>What I write about</h2>
      <ul>
        <li>
          <span class="topic">Programming and architecture</span>
          <span class="topic-desc">
            The decisions behind the code, not just the syntax: what holds up,
            what ages badly, and why.
          </span>
        </li>
        <li>
          <span class="topic">AI</span>
          <span class="topic-desc">
            Less hype, more honest notes on what it actually changes in the way
            we build and think.
          </span>
        </li>
        <li>
          <span class="topic">Competitive programming</span>
          <span class="topic-desc">
            The problems I solve for the pleasure of it, and what they teach
            about thinking clearly under constraints.
          </span>
        </li>
        <li>
          <span class="topic">Travel</span>
          <span class="topic-desc">
            Photos and field notes from the road, and what moving around does to
            the way you see things.
          </span>
        </li>
      </ul>
    </div>

    <div class="gallery rise" style="--d:0.3s">
      <h2>From the road</h2>
      <div class="gallery-grid" data-lightbox>
        {
          gallery.map((photo) => (
            <button
              type="button"
              class="shot"
              data-lightbox-item
              aria-haspopup="dialog"
              style={`--ar:${photo.src.width / photo.src.height}`}
            >
              <Image
                src={photo.src}
                alt={photo.alt}
                format="avif"
                widths={[280, 420, 560, 800, 1280]}
                sizes="(max-width: 34rem) 100vw, 30vw"
              />
            </button>
          ))
        }
      </div>
    </div>

    <div class="links rise" style="--d:0.36s">
      <h2>Find me</h2>
      <ul>
        {
          SOCIALS.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="me noopener noreferrer">
                {s.label}
                <span class="arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Lightbox />
</BaseLayout>

<style>
  .about {
    padding-top: clamp(3rem, 8vw, 5.5rem);
  }
  .about h1 {
    font-size: var(--step-4);
    letter-spacing: -0.03em;
    margin-top: 0.4rem;
  }
  /* A small portrait beside the title. On wide screens it hangs in the left
     gutter (negative margin), so the heading lines up with the body text below;
     on narrow screens it simply sits inline, just left of the title. */
  .intro {
    --portrait-size: clamp(3.25rem, 8vw, 4.75rem);
    --intro-gap: clamp(0.85rem, 2.5vw, 1.35rem);
    display: flex;
    align-items: center;
    gap: var(--intro-gap);
  }
  .intro-text {
    min-width: 0;
  }
  .portrait {
    flex: none;
    width: var(--portrait-size);
  }
  .portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
  }
  @media (min-width: 64rem) {
    .intro {
      margin-left: calc(-1 * (var(--portrait-size) + var(--intro-gap)));
    }
  }
  .lede {
    margin-top: 1.8rem;
    font-size: var(--step-1);
    line-height: 1.7;
  }
  .lede > * + * {
    margin-top: 1.2rem;
  }
  .topics {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .topics h2 {
    font-size: var(--step-1);
  }
  .topics ul {
    list-style: none;
    padding: 0;
    margin-top: 1.4rem;
    display: grid;
    gap: 1.4rem;
  }
  .topics li {
    display: grid;
    gap: 0.3rem;
  }
  .topic {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--step-0);
    color: var(--primary);
  }
  .topic-desc {
    color: var(--muted);
    line-height: 1.6;
    text-wrap: pretty;
  }
  .gallery {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .gallery h2 {
    font-size: var(--step-1);
  }
  /* Justified strip: each shot grows in proportion to its photo's aspect
     ratio (--ar = width/height) from a zero basis, so every image keeps its
     full frame yet the row lands on a single even height. Each is a button
     that opens the shared lightbox. */
  .gallery-grid {
    margin-top: 1.4rem;
    display: flex;
    gap: 0.7rem;
  }
  .gallery-grid .shot {
    appearance: none;
    display: block;
    padding: 0;
    flex: var(--ar) 1 0;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    cursor: zoom-in;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out);
  }
  .gallery-grid .shot:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }
  .gallery-grid img {
    width: 100%;
    height: auto;
  }
  /* Too narrow for a three-up strip: stack to full-width frames instead. */
  @media (max-width: 34rem) {
    .gallery-grid {
      flex-direction: column;
      gap: 0.8rem;
    }
    .gallery-grid .shot {
      flex: none;
    }
  }
  .links {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .links h2 {
    font-size: var(--step-1);
  }
  .links ul {
    list-style: none;
    padding: 0;
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-ui);
    font-weight: 560;
    text-decoration: none;
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    color: var(--ink);
    transition:
      border-color 0.2s var(--ease-out),
      transform 0.2s var(--ease-out),
      color 0.2s var(--ease-out);
  }
  .links a:hover {
    color: var(--primary);
    border-color: var(--primary);
    transform: translateY(-1px);
  }
  .arrow {
    transition: transform 0.2s var(--ease-out);
  }
  .links a:hover .arrow {
    transform: translate(2px, -2px);
  }
</style>
