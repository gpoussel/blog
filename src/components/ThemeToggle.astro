---
// Light/dark toggle. The initial state is set without flash by the inline
// script in <head> (see BaseLayout). Here we only handle the click and icon.
---

<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-label="Toggle light / dark theme"
  title="Light / dark theme"
>
  <svg
    class="sun"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
    <g
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      fill="none"
    >
      <path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4"></path>
      <path d="M5 5l1.7 1.7M17.3 17.3L19 19M19 5l-1.7 1.7M6.7 17.3L5 19"></path>
    </g>
  </svg>
  <svg
    class="moon"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    aria-hidden="true"
  >
    <path
      d="M20 14.5A8 8 0 0 1 9.5 4a0.5 0.5 0 0 0-0.7-0.6A8.6 8.6 0 1 0 20.6 15.2a0.5 0.5 0 0 0-0.6-0.7Z"
      fill="currentColor"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    --size: 2.5rem;
    inline-size: var(--size);
    block-size: var(--size);
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--ink);
    border-radius: 999px;
    cursor: pointer;
    position: relative;
    transition:
      border-color 0.2s var(--ease-out),
      background 0.2s var(--ease-out),
      transform 0.2s var(--ease-out);
  }
  .theme-toggle:hover {
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }
  .theme-toggle svg {
    grid-area: 1 / 1;
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.4s var(--ease-out);
  }
  /* light shown -> offer the moon; dark shown -> offer the sun */
  .moon {
    opacity: 0;
    transform: rotate(-40deg) scale(0.6);
  }
  .sun {
    opacity: 1;
    transform: rotate(0) scale(1);
  }
  :root[data-theme="dark"] .moon {
    opacity: 1;
    transform: rotate(0) scale(1);
  }
  :root[data-theme="dark"] .sun {
    opacity: 0;
    transform: rotate(40deg) scale(0.6);
  }
</style>

<script>
  const KEY = "theme";
  const btn = document.getElementById("theme-toggle");
  btn?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try {
      localStorage.setItem(KEY, next);
    } catch {}
  });
</script>
