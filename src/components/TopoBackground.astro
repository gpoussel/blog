---
/**
 * Signature background: real contour lines, like a topographic map.
 *
 * The contour geometry is generated by utils/topo.ts (fBm value noise ->
 * marching squares -> stitched, smoothed polylines), deterministic so builds
 * stay reproducible. The same generator feeds the social-share images
 * (utils/og.ts). This component just sizes the canvas and paints the paths.
 *
 * Purely decorative: aria-hidden, fixed, very low opacity. Every sixth line
 * is an "index" contour (mauve), as on real maps.
 */
import { generateContours } from "../utils/topo";

const W = 1640;
const H = 1160;

const paths = generateContours({
  width: W,
  height: H,
  cell: 17, // sampling step (px): smaller = smoother, heavier
  noiseScale: 470, // larger = broader patterns
  warp: 0.16, // domain-warping strength: lower = less erratic
  octaves: 3, // noise detail: fewer = rounder, softer curves
  levels: 24, // number of contour lines: more = tighter lines
  masterEvery: 6, // one index contour (mauve) every N
});
---

<div class="topo" aria-hidden="true">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
  >
    {
      paths.map((p) => (
        <path
          d={p.d}
          stroke={p.master ? "var(--topo-strong)" : "var(--topo)"}
          stroke-width={p.master ? 1.25 : 1}
          stroke-linejoin="round"
          stroke-linecap="round"
          vector-effect="non-scaling-stroke"
        />
      ))
    }
  </svg>
</div>

<style>
  .topo {
    position: fixed;
    inset: 0;
    z-index: var(--z-bg);
    pointer-events: none;
    overflow: hidden;
    /* soft fade toward the edges so the pattern does not cut off abruptly */
    -webkit-mask-image: radial-gradient(
      135% 130% at 50% 32%,
      black 48%,
      transparent 100%
    );
    mask-image: radial-gradient(
      135% 130% at 50% 32%,
      black 48%,
      transparent 100%
    );
  }
  .topo svg {
    width: 100%;
    height: 100%;
  }
</style>
